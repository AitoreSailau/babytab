# LLM (optional — the app falls back to the rules-based parser and template explanations)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# or
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe TEST mode (optional — without it the paywall uses a built-in demo checkout)
STRIPE_SECRET_KEY=sk_test_...
ENTITLEMENT_SECRET=change-me-long-random-string

# Family account: Google sign-in + one shared household for Mom's and Dad's Gmail (optional)
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web) → add your site URL to "Authorized JavaScript origins"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 2) Vercel → Storage → Upstash Redis (adds these two automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 3) ENTITLEMENT_SECRET above must be set: it also signs sign-in sessions
